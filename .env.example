# AI Configuration
GROQ_API_KEY="your_groq_api_key"

# Notion Configuration
NOTION_API_KEY="your_notion_api_key"
NOTION_DATABASE_ID="your_notion_database_id"

# Server Configuration
PORT=3000
NODE_ENV="development"
# Comma-separated list of allowed origins in production (e.g. https://yourdomain.com)
CORS_ORIGIN=""
LOG_LEVEL="info"

# Facebook Messenger Configuration
FB_PAGE_ACCESS_TOKEN="your_page_access_token"
FB_VERIFY_TOKEN="your_custom_verify_token"

# Telegram Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"

# PostgreSQL Configuration (Optional Persistence)
ENABLE_POSTGRES_STORAGE=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gemini_bridge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
