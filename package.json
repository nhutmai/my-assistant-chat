{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node build/server.js",
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:prod": "npm run build && npm run build:server",
    "preview": "vite preview",

    "openapi:build": "npx --yes @redocly/cli build-docs openapi.yaml -o openapi.html",
    "openapi:preview": "npm run openapi:build && python3 -m http.server 8080 --bind 127.0.0.1",
    "openapi:stop": "kill $(lsof -tiTCP:8080 -sTCP:LISTEN) 2>/dev/null || true",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "migrate": "tsx migrate.ts up",
    "migrate:status": "tsx migrate.ts status",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.0",
    "axios": "^1.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.37.0",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",

    "vitest": "^4.1.7"
  }
}
